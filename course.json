<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>كورس Miss Dodo</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Cairo',sans-serif}
body{background:#0f0e2e;color:#fff;display:flex;justify-content:center}
.app{width:100%;max-width:480px;min-height:100vh;background:#0f0e2e;padding:10px}
.top{display:flex;justify-content:space-between;align-items:center;background:#1e1b4b;padding:12px;border-radius:12px;margin-bottom:10px;border:2px solid #facc15}
.top a{background:#2d2a6a;color:#fff;padding:6px 14px;border-radius:8px;text-decoration:none;font-weight:800}
.top h2{font-size:18px}
.box{background:#fff;color:#111;border-radius:14px;padding:12px}
.step{margin-bottom:18px}
.step-title{font-size:20px;font-weight:900;color:#0d9488;margin-bottom:4px}
.step-sub{color:#666;font-size:14px;margin-bottom:10px;text-align:right}
.grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.card{background:#FFF3CD;border:2px solid #312e81;border-radius:12px;padding:12px 6px;text-align:center;cursor:pointer;min-height:110px}
.card:active{transform:scale(.97)}
.en{font-size:22px;font-weight:900;color:#1e1b4b !important;line-height:1.2;direction:ltr}
.pron{font-size:15px;font-weight:800;color:#d97706;margin:6px 0}
.ar{font-size:15px;color:#333;line-height:1.4}
.note{background:#fef3c7;border:2px solid #facc15;border-radius:10px;padding:10px;font-size:15px;font-weight:800;text-align:right;margin-top:10px;color:#111}
</style>
</head>
<body>
<div class="app">
<div class="top"><a href="index.html">› رجوع</a><h2>📚 كورس Miss Dodo</h2><span></span></div>
<div class="box" id="courseBox"><p style="text-align:center;padding:20px">جاري تحميل الكورس...</p></div>
</div>
<script>
function speakEn(t){if(!t)return;speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(t);u.lang='en-US';u.rate=0.75;speechSynthesis.speak(u);}
async function loadCourse(){
  try{
    let r=await fetch('course.json?t='+Date.now());
    let data=await r.json();
    let html='';
    data.forEach(s=>{
      html+=`<div class="step"><div class="step-title">${s.title}</div><div class="step-sub">${s.sub||''}</div><div class="grid">`;
      s.words.forEach(w=>{
        html+=`<div class="card" onclick="speakEn('${w.en.replace(/'/g,"")}')"><div class="en">${w.en}</div><div class="pron">${w.pron||''}</div><div class="ar">${w.ar||''}</div></div>`;
      });
      html+=`</div>`;
      if(s.note) html+=`<div class="note">💡 ${s.note}</div>`;
      html+=`</div>`;
    });
    document.getElementById('courseBox').innerHTML=html;
  }catch(e){
    document.getElementById('courseBox').innerHTML='<p style="text-align:center">مش قادر أحمل الكورس، اتأكد إن ملف course.json موجود جنب course.html</p>';
  }
}
loadCourse();
</script>
</body>
</html>
