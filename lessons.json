[
  {
    "id": 1,
    "title": "التعارف",
    "lines": [
      {"en": "Hello, how are you?", "pron": "هيلو، هاو آر يو؟", "ar": "أهلاً، كيف حالك؟"},
      {"en": "I'm fine, thank you. And you?", "pron": "آيم فاين، ثانك يو. أند يو؟", "ar": "أنا بخير، شكراً لك. وأنت؟"},
      {"en": "I'm good too.", "pron": "آيم جود تو.", "ar": "أنا بخير أيضاً."},
      {"en": "What is your name?", "pron": "وات إز يور نيم؟", "ar": "ما اسمك؟"},
      {"en": "My name is Ahmed.", "pron": "ماي نيم إز أحمد.", "ar": "اسمي أحمد."},
      {"en": "Nice to meet you, Ahmed.", "pron": "نايس تو ميت يو، أحمد.", "ar": "سعيد بلقائك يا أحمد."},
      {"en": "Nice to meet you too.", "pron": "نايس تو ميت يو تو.", "ar": "سعيد بلقائك أيضاً."},
      {"en": "Where are you from?", "pron": "وير آر يو فروم؟", "ar": "من أين أنت؟"},
      {"en": "I'm from Egypt.", "pron": "آيم فروم إيجيبت.", "ar": "أنا من مصر."},
      {"en": "Welcome to Egypt!", "pron": "ويلكم تو إيجيبت!", "ar": "أهلاً بك في مصر!"}
    ]
  },
  {
    "id": 2,
    "title": "في الشارع",
    "lines": [
      {"en": "Excuse me, where is the street?", "pron": "إكسيوز مي، وير إز ذا ستريت؟", "ar": "عذراً، أين الشارع؟"},
      {"en": "Go straight ahead.", "pron": "جو ستريت أهيد.", "ar": "امشِ على طول."},
      {"en": "Then turn right.", "pron": "ذين تيرن رايت.", "ar": "ثم اتجه يميناً."},
      {"en": "Is it far from here?", "pron": "إز إت فار فروم هير؟", "ar": "هل هو بعيد من هنا؟"},
      {"en": "No, it's very near.", "pron": "نو، إتس فيري نير.", "ar": "لا، إنه قريب جداً."},
      {"en": "How can I go there?", "pron": "هاو كان آي جو ذير؟", "ar": "كيف يمكنني الذهاب إلى هناك؟"},
      {"en": "You can take a taxi.", "pron": "يو كان تيك أ تاكسي.", "ar": "يمكنك أن تأخذ تاكسي."},
      {"en": "Thank you very much.", "pron": "ثانك يو فيري ماتش.", "ar": "شكراً جزيلاً لك."},
      {"en": "You're welcome.", "pron": "يور ويلكم.", "ar": "على الرحب والسعة."}
    ]
  },
  {
    "id": 3,
    "title": "في المطعم",
    "lines": [
      {"en": "Hello, I want a table for two.", "pron": "هيلو، آي وانت أ تيبل فور تو.", "ar": "أهلاً، أريد طاولة لشخصين."},
      {"en": "Please sit here.", "pron": "بليز سيت هير.", "ar": "من فضلك اجلس هنا."},
      {"en": "Can I see the menu?", "pron": "كان آي سي ذا مينيو؟", "ar": "هل يمكنني رؤية قائمة الطعام؟"},
      {"en": "Here you are.", "pron": "هير يو آر.", "ar": "تفضل، ها هي."},
      {"en": "What do you want to eat?", "pron": "وات دو يو وانت تو إيت؟", "ar": "ماذا تريد أن تأكل؟"},
      {"en": "I want chicken and rice.", "pron": "آي وانت تشيكن أند رايس.", "ar": "أريد دجاج وأرز."},
      {"en": "What do you want to drink?", "pron": "وات دو يو وانت تو درينك؟", "ar": "ماذا تريد أن تشرب؟"},
      {"en": "I want water, please.", "pron": "آي وانت ووتر، بليز.", "ar": "أريد ماء، من فضلك."},
      {"en": "The food is very delicious.", "pron": "ذا فود إز فيري ديليشس.", "ar": "الطعام لذيذ جداً."},
      {"en": "Can I have the bill, please?", "pron": "كان آي هاف ذا بيل، بليز؟", "ar": "هل يمكنني الحصول على الفاتورة، من فضلك؟"}
    ]
  },
  {
    "id": 4,
    "title": "في الشغل",
    "lines": [
      {"en": "Good morning, everyone.", "pron": "جود مورنينج، إفري وان.", "ar": "صباح الخير، جميعاً."},
      {"en": "Good morning, boss.", "pron": "جود مورنينج، بوس.", "ar": "صباح الخير، يا مدير."},
      {"en": "What are you doing now?", "pron": "وات آر يو دوينج ناو؟", "ar": "ماذا تفعل الآن؟"},
      {"en": "I'm working on a new project.", "pron": "آيم ووركينج أون أ نيو بروجيكت.", "ar": "أنا أعمل على مشروع جديد."},
      {"en": "Can you help me, please?", "pron": "كان يو هيلب مي، بليز؟", "ar": "هل يمكنك مساعدتي، من فضلك؟"},
      {"en": "Yes, of course.", "pron": "يس، أوف كورس.", "ar": "نعم، بالطبع."},
      {"en": "When is the meeting?", "pron": "وين إز ذا ميتينج؟", "ar": "متى الاجتماع؟"},
      {"en": "The meeting is at ten.", "pron": "ذا ميتينج إز آت تين.", "ar": "الاجتماع الساعة العاشرة."},
      {"en": "I finished my work.", "pron": "آي فينيشد ماي وورك.", "ar": "أنهيت عملي."},
      {"en": "Great job! See you tomorrow.", "pron": "جريت جوب! سي يو تومورو.", "ar": "عمل رائع! أراك غداً."}
    ]
  },
  {
    "id": 5,
    "title": "في السفر",
    "lines": [
      {"en": "Where are you traveling to?", "pron": "وير آر يو ترافلينج تو؟", "ar": "إلى أين تسافر؟"},
      {"en": "I'm traveling to London.", "pron": "آيم ترافلينج تو لندن.", "ar": "أنا مسافر إلى لندن."},
      {"en": "When is your flight?", "pron": "وين إز يور فلايت؟", "ar": "متى رحلتك؟"},
      {"en": "My flight is tomorrow.", "pron": "ماي فلايت إز تومورو.", "ar": "رحلتي غداً."},
      {"en": "Can I see your passport?", "pron": "كان آي سي يور باسبورت؟", "ar": "هل يمكنني رؤية جواز سفرك؟"},
      {"en": "Here is my passport.", "pron": "هير إز ماي باسبورت.", "ar": "هذا هو جواز سفري."},
      {"en": "Have a nice trip!", "pron": "هاف أ نايس تريب!", "ar": "رحلة سعيدة!"},
      {"en": "Thank you, see you soon.", "pron": "ثانك يو، سي يو سون.", "ar": "شكراً، أراك قريباً."}
    ]
  },
  {
    "id": 6,
    "title": "في المدرسة",
    "lines": [
      {"en": "Good morning, teacher.", "pron": "جود مورنينج، تيتشر.", "ar": "صباح الخير، يا معلم."},
      {"en": "Good morning, students.", "pron": "جود مورنينج، ستيودنتس.", "ar": "صباح الخير، أيها الطلاب."},
      {"en": "Open your books, please.", "pron": "أوبن يور بوكس، بليز.", "ar": "افتحوا كتبكم، من فضلكم."},
      {"en": "What is today's lesson?", "pron": "وات إز تودايز ليسون؟", "ar": "ما درس اليوم؟"},
      {"en": "Today we learn English.", "pron": "توداي وي ليرن إنجليش.", "ar": "اليوم نتعلم الإنجليزية."},
      {"en": "Can you repeat, please?", "pron": "كان يو ريبيت، بليز؟", "ar": "هل يمكنك أن تعيد، من فضلك؟"},
      {"en": "Yes, listen again.", "pron": "يس، ليسن أجين.", "ar": "نعم، استمع مرة أخرى."},
      {"en": "I understand now.", "pron": "آي أندرستاند ناو.", "ar": "أنا فهمت الآن."},
      {"en": "Excellent! Very good.", "pron": "إكسلنت! فيري جود.", "ar": "ممتاز! جيد جداً."},
      {"en": "See you tomorrow, teacher.", "pron": "سي يو تومورو، تيتشر.", "ar": "أراك غداً، يا معلم."}
    ]
  },
  {
    "id": 7,
    "title": "في البيت",
    "lines": [
      {"en": "Welcome home, dad.", "pron": "ويلكم هوم، داد.", "ar": "أهلاً بعودتك للبيت، يا أبي."},
      {"en": "Thank you, my son.", "pron": "ثانك يو، ماي صن.", "ar": "شكراً لك، يا ابني."},
      {"en": "How was your day?", "pron": "هاو واز يور داي؟", "ar": "كيف كان يومك؟"},
      {"en": "My day was great.", "pron": "ماي داي واز جريت.", "ar": "كان يومي رائعاً."},
      {"en": "Are you hungry?", "pron": "آر يو هانجري؟", "ar": "هل أنت جائع؟"},
      {"en": "Yes, I'm very hungry.", "pron": "يس، آيم فيري هانجري.", "ar": "نعم، أنا جائع جداً."},
      {"en": "Let's eat together.", "pron": "ليتس إيت توجيذر.", "ar": "هيا نأكل معاً."},
      {"en": "The food is ready.", "pron": "ذا فود إز ريدي.", "ar": "الطعام جاهز."},
      {"en": "I want to sleep now.", "pron": "آي وانت تو سليب ناو.", "ar": "أريد أن أنام الآن."},
      {"en": "Good night, sweet dreams.", "pron": "جود نايت، سويت دريمز.", "ar": "تصبح على خير، أحلام سعيدة."}
    ]
  },
  {
    "id": 8,
    "title": "في السوق",
    "lines": [
      {"en": "Hello, how much is this?", "pron": "هيلو، هاو ماتش إز ذيس؟", "ar": "أهلاً، بكم هذا؟"},
      {"en": "It is fifty pounds.", "pron": "إت إز فيفتي باوندز.", "ar": "إنه بخمسين جنيهاً."},
      {"en": "That's too expensive.", "pron": "ذاتس تو إكسبينسيف.", "ar": "هذا غالٍ جداً."},
      {"en": "Can you make it cheaper?", "pron": "كان يو ميك إت تشيبر؟", "ar": "هل يمكنك أن تجعله أرخص؟"},
      {"en": "Okay, forty pounds for you.", "pron": "أوكي، فورتي باوندز فور يو.", "ar": "حسناً، أربعون جنيهاً لك."},
      {"en": "Do you have a bigger size?", "pron": "دو يو هاف أ بيجر سايز؟", "ar": "هل لديك مقاس أكبر؟"},
      {"en": "Yes, here it is.", "pron": "يس، هير إت إز.", "ar": "نعم، ها هو."},
      {"en": "I like it, I will take it.", "pron": "آي لايك إت، آي ويل تيك إت.", "ar": "أعجبني، سآخذه."},
      {"en": "Thank you, come again.", "pron": "ثانك يو، كام أجين.", "ar": "شكراً لك، تعال مرة أخرى."}
    ]
  },
  {
    "id": 9,
    "title": "عند الدكتور",
    "lines": [
      {"en": "Good morning, doctor.", "pron": "جود مورنينج، دكتور.", "ar": "صباح الخير، يا دكتور."},
      {"en": "Good morning, what is wrong?", "pron": "جود مورنينج، وات إز رونج؟", "ar": "صباح الخير، ما المشكلة؟"},
      {"en": "I have a headache.", "pron": "آي هاف أ هيديك.", "ar": "عندي صداع."},
      {"en": "Do you have a fever?", "pron": "دو يو هاف أ فيفر؟", "ar": "هل عندك حرارة؟"},
      {"en": "Yes, a little bit.", "pron": "يس، أ ليتل بيت.", "ar": "نعم، قليلاً."},
      {"en": "Take this medicine.", "pron": "تيك ذيس ميديسين.", "ar": "خذ هذا الدواء."},
      {"en": "How many times a day?", "pron": "هاو ميني تايمز أ داي؟", "ar": "كم مرة في اليوم؟"},
      {"en": "Three times a day.", "pron": "ثري تايمز أ داي.", "ar": "ثلاث مرات في اليوم."},
      {"en": "Get well soon.", "pron": "جيت ويل سون.", "ar": "شفاك الله، أتمنى لك الشفاء قريباً."},
      {"en": "Thank you, doctor.", "pron": "ثانك يو، دكتور.", "ar": "شكراً لك، يا دكتور."}
    ]
  },
  {
    "id": 10,
    "title": "في المطار",
    "lines": [
      {"en": "Where is the airport?", "pron": "وير إز ذا إيربورت؟", "ar": "أين المطار؟"},
      {"en": "The airport is far from here.", "pron": "ذا إيربورت إز فار فروم هير.", "ar": "المطار بعيد من هنا."},
      {"en": "I want to go to the airport.", "pron": "آي وانت تو جو تو ذا إيربورت.", "ar": "أريد الذهاب إلى المطار."},
      {"en": "Your ticket, please.", "pron": "يور تيكيت، بليز.", "ar": "تذكرتك، من فضلك."},
      {"en": "Here is my ticket.", "pron": "هير إز ماي تيكيت.", "ar": "هذه تذكرتي."},
      {"en": "Have a safe flight.", "pron": "هاف أ سيف فلايت.", "ar": "رحلة آمنة."},
      {"en": "Thank you very much.", "pron": "ثانك يو فيري ماتش.", "ar": "شكراً جزيلاً لك."}
    ]
  },
  {
    "id": 11,
    "title": "في الفندق",
    "lines": [
      {"en": "Hello, I want a room.", "pron": "هيلو، آي وانت أ روم.", "ar": "أهلاً، أريد غرفة."},
      {"en": "For how many nights?", "pron": "فور هاو ميني نايتس؟", "ar": "لعدد كم ليلة؟"},
      {"en": "For two nights.", "pron": "فور تو نايتس.", "ar": "ليلتين."},
      {"en": "Here is your key.", "pron": "هير إز يور كي.", "ar": "هذا هو مفتاحك."},
      {"en": "What time is breakfast?", "pron": "وات تايم إز بريكفاست؟", "ar": "متى وقت الإفطار؟"},
      {"en": "Breakfast is at eight.", "pron": "بريكفاست إز آت إيت.", "ar": "الإفطار الساعة الثامنة."},
      {"en": "Thank you, this room is nice.", "pron": "ثانك يو، ذيس روم إز نايس.", "ar": "شكراً لك، هذه الغرفة جميلة."}
    ]
  },
  {
    "id": 12,
    "title": "مع الأصدقاء",
    "lines": [
      {"en": "Hi, long time no see!", "pron": "هاي، لونج تايم نو سي!", "ar": "أهلاً، مضى وقت طويل لم أرك!"},
      {"en": "Yes, I missed you!", "pron": "يس، آي ميست يو!", "ar": "نعم، اشتقت إليك!"},
      {"en": "Let's go out today.", "pron": "ليتس جو آوت توداي.", "ar": "هيا نخرج اليوم."},
      {"en": "Where do you want to go?", "pron": "وير دو يو وانت تو جو؟", "ar": "إلى أين تريد أن تذهب؟"},
      {"en": "Let's go to the park.", "pron": "ليتس جو تو ذا بارك.", "ar": "هيا نذهب إلى الحديقة."},
      {"en": "Good idea, let's go.", "pron": "جود آيديا، ليتس جو.", "ar": "فكرة جيدة، هيا بنا."},
      {"en": "I had a great time.", "pron": "آي هاد أ جريت تايم.", "ar": "قضيت وقتاً رائعاً."},
      {"en": "Me too, see you soon.", "pron": "مي تو، سي يو سون.", "ar": "وأنا أيضاً، أراك قريباً."}
    ]
  },
  {
    "id": 13,
    "title": "في التليفون",
    "lines": [
      {"en": "Hello, who is speaking?", "pron": "هيلو، هو إز سبيكينج؟", "ar": "أهلاً، من يتحدث؟"},
      {"en": "It's me, Ali.", "pron": "إتس مي، علي.", "ar": "إنه أنا، علي."},
      {"en": "Hi Ali, how are you?", "pron": "هاي علي، هاو آر يو؟", "ar": "أهلاً علي، كيف حالك؟"},
      {"en": "Can I talk to Sara?", "pron": "كان آي توك تو سارة؟", "ar": "هل يمكنني التحدث إلى سارة؟"},
      {"en": "She is not here now.", "pron": "شي إز نوت هير ناو.", "ar": "هي ليست هنا الآن."},
      {"en": "Please tell her I called.", "pron": "بليز تيل هير آي كولد.", "ar": "من فضلك أخبرها أنني اتصلت."},
      {"en": "Okay, I will tell her.", "pron": "أوكي، آي ويل تيل هير.", "ar": "حسناً، سأخبرها."},
      {"en": "Thank you, bye.", "pron": "ثانك يو، باي.", "ar": "شكراً لك، وداعاً."}
    ]
  },
  {
    "id": 14,
    "title": "في البنك",
    "lines": [
      {"en": "Hello, I want to open an account.", "pron": "هيلو، آي وانت تو أوبن أن أكاونت.", "ar": "أهلاً، أريد فتح حساب."},
      {"en": "Do you have your ID?", "pron": "دو يو هاف يور آي دي؟", "ar": "هل معك بطاقتك؟"},
      {"en": "Yes, here it is.", "pron": "يس، هير إت إز.", "ar": "نعم، ها هي."},
      {"en": "I want to save money.", "pron": "آي وانت تو سيف ماني.", "ar": "أريد أن أدخر مالاً."},
      {"en": "How much money?", "pron": "هاو ماتش ماني؟", "ar": "كم من المال؟"},
      {"en": "One thousand pounds.", "pron": "وان ثاوزند باوندز.", "ar": "ألف جنيه."},
      {"en": "Done, thank you.", "pron": "دان، ثانك يو.", "ar": "تم، شكراً لك."}
    ]
  },
  {
    "id": 15,
    "title": "في المكتبة",
    "lines": [
      {"en": "Excuse me, where are the English books?", "pron": "إكسيوز مي، وير آر ذا إنجليش بوكس؟", "ar": "عذراً، أين كتب الإنجليزية؟"},
      {"en": "They are on the second floor.", "pron": "ذاي آر أون ذا سيكند فلور.", "ar": "إنها في الدور الثاني."},
      {"en": "Can I borrow this book?", "pron": "كان آي بورو ذيس بوك؟", "ar": "هل يمكنني استعارة هذا الكتاب؟"},
      {"en": "Yes, for one week.", "pron": "يس، فور وان ويك.", "ar": "نعم، لمدة أسبوع."},
      {"en": "I love reading.", "pron": "آي لوف ريدينج.", "ar": "أنا أحب القراءة."},
      {"en": "Reading is very useful.", "pron": "ريدينج إز فيري يوزفول.", "ar": "القراءة مفيدة جداً."},
      {"en": "Thank you for your help.", "pron": "ثانك يو فور يور هيلب.", "ar": "شكراً لك على مساعدتك."}
    ]
  },
  {
    "id": 16,
    "title": "في الصيدلية",
    "lines": [
      {"en": "Hello, I need medicine.", "pron": "هيلو، آي نيد ميديسين.", "ar": "أهلاً، أحتاج دواء."},
      {"en": "What do you need?", "pron": "وات دو يو نيد؟", "ar": "ماذا تحتاج؟"},
      {"en": "Medicine for headache.", "pron": "ميديسين فور هيديك.", "ar": "دواء للصداع."},
      {"en": "Here you are.", "pron": "هير يو آر.", "ar": "تفضل، ها هو."},
      {"en": "How much is it?", "pron": "هاو ماتش إز إت؟", "ar": "بكم هو؟"},
      {"en": "It is thirty pounds.", "pron": "إت إز ثيرتي باوندز.", "ar": "إنه بثلاثين جنيهاً."},
      {"en": "Thank you.", "pron": "ثانك يو.", "ar": "شكراً لك."}
    ]
  },
  {
    "id": 17,
    "title": "في الجيم",
    "lines": [
      {"en": "Hello, I want to join the gym.", "pron": "هيلو، آي وانت تو جوين ذا جيم.", "ar": "أهلاً، أريد الاشتراك في الجيم."},
      {"en": "Welcome! How old are you?", "pron": "ويلكم! هاو أولد آر يو؟", "ar": "أهلاً بك! كم عمرك؟"},
      {"en": "I'm twenty years old.", "pron": "آيم توينتي ييرز أولد.", "ar": "عمري عشرون سنة."},
      {"en": "Do you exercise every day?", "pron": "دو يو إكسرسايز إفري داي؟", "ar": "هل تتمرن كل يوم؟"},
      {"en": "Yes, I try.", "pron": "يس، آي تراي.", "ar": "نعم، أحاول."},
      {"en": "Let's start now.", "pron": "ليتس ستارت ناو.", "ar": "هيا نبدأ الآن."},
      {"en": "This is hard but good.", "pron": "ذيس إز هارد بات جود.", "ar": "هذا صعب لكنه جيد."},
